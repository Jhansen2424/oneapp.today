# Server-only OneApp CRM form endpoint. Preview should target staging; production
# should target prod. The form key remains out of the browser bundle because the
# site posts through /api/demo-request.
ONEAPP_LEAD_FORM_URL=https://staging.oneapp.today/api/v1/lead-forms/REPLACE_WITH_32_CHAR_FORM_KEY/submit

# Prefer GTM when a container is available. If GTM is set, the direct GA4 ID is
# ignored to avoid duplicate page views. Tracking loads only after consent.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
